# Required: your own published Aliyun multimodal application.
app_id=
key=
workspace_id=
voice_id=
# Stable cloud memory identity, 1-36 characters.
user_id=olivia-soul
# Paste the complete launch URL of your running dsh instance.
dsh_url=http://127.0.0.1:8766/?token=REPLACE_WITH_YOUR_TOKEN
# Optional existing absolute path. Empty uses Documents/home.
dsh_cwd=
# GPU is optional. See docs/gpu.md.
gpu_enabled=false
gpu_url=http://127.0.0.1:8765
# Optional RAM credentials for development memory management.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
# Optional developer tracing; disabled by default.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3300
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
SOUL_CLOUD_VERSION=
LANGFUSE_RELEASE=
